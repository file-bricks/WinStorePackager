# =============================================================================
# .gitignore Template für Software-Entwicklungsprojekte
# Kopieren und als .gitignore im Projektroot ablegen
# Projektspezifische Einträge am Ende anfügen
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md
tmpclaude-*

# ---- Persoenliche / Sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
secrets.*
*.pem
*.key
*.p12
*.pfx
keyring/

# ---- Build-Artefakte & Releases ----
releases/*
!releases/windowsstore/
releases/windowsstore/*
!releases/windowsstore/screenshots/
!releases/windowsstore/screenshots/*.png
_WARTUNG/
*.exe
*.msi
*.msix
*.appx
*.spec
!WinStorePackager.spec
*.tmp
*.zip
.licenses_cache.json

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Standard-Patterns ----
PLAN.txt
_archive/
_private/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Projektspezifisch ----
settings_store_packager.json
store_package/
*.pfx
*.cer
*.crt
*.msixupload
*.appxsym
AppxManifest.xml
Package.appxmanifest
/screenshots/
wack-results/
TestResults/
*.appcertlog
DECISIONS.md
PORTIERUNGSPLAN.md
TODO.md
DONE.md

# ---- Multi-Host-Synchronisation & Konfliktschutz ----
*.sync-conflict-*
*.sync-temp-*
*.conflict
*-CONFLIT-*
*-conflict-*
*-WORKSTATION*
*-WORKSTATION-LG*
*_WORKSTATION*
*_WORKSTATION-LG*
*-WORKSTATION.*
*-WORKSTATION-LG.*
*-ASUS*
*-ASUS-GEI*
*-LAPTOP*
*-Mac Studio*
*-MacBook*
*-IDEAPAD*
* (kopie)*
* (Kopie)*
* (copy)*
* (Copy)*
*conflicted copy*

# ---- Multi-Agent Locks & Lock-System ----
LOCK
LOCK.*
*.lock
!package-lock.json
LOCK*.txt
LOCK.user.*
LOCK.until.*
LOCK.condition.*
LOCK.permissions.json
.automation-lock
uv.lock

# ---- Packaging, Smoke Tests, Caches & Coverage ----
wheelhouse/
.wheel-smoke/
*.bak
*.orig
*.rej
.pytest_temp/
.pytest_tmp*/
.hypothesis/
.turbo/
.nyc_output/
.tox/
.coverage*
htmlcov/

# Agenten-interne Loop-Statusschnappschuesse (GITHUB-POLICY.md SS3, T-20260926-510472849)
TASKPLAN_STATUS_*.md
