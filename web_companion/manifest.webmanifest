{
  "id": "./index.html",
  "name": "WinStorePackager Companion",
  "short_name": "WSP Companion",
  "description": "Lokaler Web-Companion für Store-Metadaten, Manifest-Vorschau und JSON-Profilbearbeitung.",
  "lang": "de",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "browser"
  ],
  "background_color": "#f3efe5",
  "theme_color": "#0b6a74",
  "categories": [
    "productivity",
    "developer tools"
  ],
  "icons": [
    {
      "src": "./icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
